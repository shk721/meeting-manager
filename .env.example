# ─── Required ──────────────────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/meeting_manager
NODE_ENV=development

# ─── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-in-production

# ─── Database seeding ──────────────────────────────────────────────────────────
# Set to any value to allow POST /seed (used by Railway start command)
SEED_KEY=

# ─── SMTP — Weekly report mailer (Sprint 6B) ───────────────────────────────────
# Leave blank to disable automatic email reports.
# The mailer runs every 6 h and sends on Sundays (weekly) / 1st of month (monthly).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=reports@example.com
SMTP_PASS=your-smtp-password
# Sender address shown to recipients (falls back to SMTP_USER if unset)
SMTP_FROM=no-reply@example.com

# ─── Railway internals (set automatically, do not copy) ────────────────────────
# RAILWAY_GIT_COMMIT_SHA=
# LOG_LEVEL=info
